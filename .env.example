# --- Telegram ---
# Token from @BotFather
BOT_TOKEN=
# Your numeric Telegram user ID (get it from @userinfobot). Only this user can use the bot.
OWNER_ID=
# Optional proxy for reaching Telegram, e.g. socks5://host:port or http://host:port
TELEGRAM_PROXY=

# --- Locale ---
TZ=Asia/Tehran
# jalali | gregorian (initial value; the user can change it in Settings)
DEFAULT_CALENDAR=jalali
# toman | rial
CURRENCY=toman

# --- AI ---
# lite | standard | full | remote (see README: hardware profiles)
PROFILE=standard
# Starts the local Ollama containers. Leave EMPTY when PROFILE=remote.
COMPOSE_PROFILES=ollama

# The assistant's brain: providers are tried in this order; those without a key are skipped.
# Free API keys make Vira much smarter and faster than a CPU model (recommended). Add as many
# as you like: when one is down or out of free quota, the next answers (and you get a notice).
# The model can also be switched inside the bot: ⚙️ Settings → 🤖 AI model, or /model.
#   Gemini:        https://aistudio.google.com/apikey
#   Groq:          https://console.groq.com/keys
#   Mistral:       https://console.mistral.ai/api-keys (free "Experiment" plan)
#   GitHub Models: a GitHub token with the "models" permission
#   OpenRouter:    https://openrouter.ai/keys (free models)
LLM_PROVIDERS=gemini,groq,mistral,github,openrouter,local
GEMINI_API_KEY=
# Empty = gemini-flash-latest
GEMINI_MODEL=
GROQ_API_KEY=
# Empty = openai/gpt-oss-120b
GROQ_MODEL=
MISTRAL_API_KEY=
# Empty = mistral-small-latest
MISTRAL_MODEL=
GITHUB_TOKEN=
# Empty = openai/gpt-4.1-mini
GITHUB_MODEL=
OPENROUTER_API_KEY=
# Empty = openrouter/free (a free model with tool support, chosen per request)
OPENROUTER_MODEL=

# "local" provider: Ollama by default, or any OpenAI-compatible endpoint (e.g. OpenRouter).
LLM_BASE_URL=http://ollama:11434/v1
# Empty = profile default (lite: gemma3:1b, standard: qwen3:4b, full: qwen3:8b)
LLM_MODEL=
LLM_API_KEY=ollama
# Tool calling with the local model: auto (by model family) | on | off
LOCAL_TOOLS=auto
# Seconds to wait for an answer (CPU inference can be slow)
LLM_TIMEOUT=180
# How many previous messages the chat remembers
CHAT_MEMORY=10
# How many previous chats are kept in 🗂 Chats (older ones are deleted)
CHAT_KEEP=20
# How long Ollama keeps the model in RAM after the last message (e.g. 30m, 2h, -1 = forever)
OLLAMA_KEEP_ALIVE=30m
STT_ENABLED=true
# Empty = profile default
STT_MODEL=

# --- Reminders ---
# Clock times used for "morning", «صبح», "tonight", «شب» ...
MORNING_TIME=09:00
NOON_TIME=12:00
AFTERNOON_TIME=16:00
EVENING_TIME=19:00
NIGHT_TIME=22:00
# Daily message with today's reminders (important ones first). Default time: on / off and
# the time can be changed in ⚙️ Settings → ☀️ Morning briefing.
MORNING_BRIEFING_TIME=08:00

# --- Reports ---
# Nightly report: today's expenses, this month so far and tomorrow's reminders. Default
# time (12:00–23:59): on / off and the time can be changed in ⚙️ Settings → 🌙 Nightly report.
DAILY_REPORT_TIME=22:00

# --- Misc ---
LOG_LEVEL=INFO
# DATABASE_URL=sqlite+aiosqlite:///data/vira.db
